---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={`CV | ${SITE_TITLE}`} />
    </head>

    <body>
        <Header />

        <main class="cv-page">
            <h1>Curriculum Vitae</h1>

            <div class="cv-container">
                <iframe
                    src="https://drive.google.com/file/d/1xAWxaYMCJZ4SwxlPjTNoN8V7S8vaf813/preview"
                    title="Curriculum Vitae"
                    allow="autoplay"
                ></iframe>
            </div>
        </main>

        <Footer />
    </body>
</html>

<style>
    .cv-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
    }

    .cv-container {
        width: 100%;
        height: 80vh;
    }

    .cv-container iframe {
        width: 100%;
        height: 100%;
        border: none;
    }
</style>
