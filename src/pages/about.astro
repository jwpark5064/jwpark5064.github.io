---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
<head>
	<BaseHead title={`About | ${SITE_TITLE}`} />
</head>

<body>
	<Header />

	<main class="about-page">
		<h1>About</h1>

		<div class="about-content">
			<div class="about-text">
				<p>
					I am a computational astrophysicist specializing in star formation 
					in the early Universe. I am currently a research professor in
					the Department of Astronomy and Space Science at Kyung Hee University.
				</p>

				<p>
					I received my my bachelor's and master's degrees from Yonsei University.
					I then moved to University of Maryland, College Park, where I studied
					the formation of Population III stars. After receiving my Ph.D. in
					May 2024, I returned to South Korea and worked as a postdoctoral
					researcher at Yonsei University before joining Kyung Hee University.
				</p>

				<p>
					My research focuses on star formation in metal-free and metal-poor
					environments. I use numerical simulations to investigate how these stars
					form, which physical processes and numerical effects shape their
					predicted properties, and how they contribute to the formation
					of the galaxies in the early Universe.
				</p>
			</div>

			<div class="profile-photo">
				<img
					src="/images/about/JP.png"
					alt="Jongwon Park"
				/>
			</div>
		</div>
	</main>

	<Footer />
</body>
</html>

<style>
	.about-page {
		max-width: 1000px;
		margin: 0 auto;
		padding: 3rem 1.5rem;
	}

	.about-page h1 {
		margin-bottom: 2rem;
	}

	.about-content {
		display: grid;
		grid-template-columns: 1fr 250px;
		gap: 3rem;
		align-items: start;
	}

	.about-text p {
		line-height: 1.7;
		margin: 0 0 1.5rem;
	}

	.profile-photo img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 8px;
	}

	@media (max-width: 700px) {
		.about-page {
			padding: 2rem 1rem;
		}

		.about-content {
			grid-template-columns: 1fr;
		}

		.profile-photo {
			order: -1;
			max-width: 220px;
		}
	}
</style>
